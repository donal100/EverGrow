<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!--
      Triquetra（凯尔特三一结）：三段连续的弧线互相穿插，构成一个闭环。
      选它的理由：环本身就是「无限」，三股线彼此生长 —— 正对 ever grow 的意思，
      比原来的箭头更贴题，也更耐看。
      启动器只显示中央 72dp（18..90），弧线端点全部落在该范围内；
      三段分别用蓝/青/银，远看是一条从蓝到银的渐变带。
      描边不能吃渐变（只有 fill 可以），所以用三段实色近似。
    -->

    <path android:pathData="M54.0,22.0 Q34.0,66.5 82.6,71.5" android:strokeColor="#2E7DFF"
        android:strokeWidth="7" android:strokeLineCap="round" />
    <path android:pathData="M82.6,71.5 Q54.0,31.9 25.4,71.5" android:strokeColor="#2ED3C6"
        android:strokeWidth="7" android:strokeLineCap="round" />
    <path android:pathData="M25.4,71.5 Q74.0,66.5 54.0,22.0" android:strokeColor="#DCE7F5"
        android:strokeWidth="7" android:strokeLineCap="round" />
</vector>
