<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 通话模式要在后台一直听：请求「忽略电池优化」，由用户确认（无法静默授予） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 通话模式要用耳机麦克风：Android 12+ 没有这个权限，startBluetoothSco 会静默失效 -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 没有这一条，setMode / startBluetoothSco / setSpeakerphoneOn 全部被静默忽略
         （读得出来，写不进去）——实测 MODE_IN_COMMUNICATION 立刻回到 0 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 定位：给 agent 的 py_gps 工具读取原始 GPS 数据（经纬度/精度/高度/速度/航向） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 跑步记录：只要前台服务的类型权限。前台服务本身就是「正在使用中」，
         不需要 ACCESS_BACKGROUND_LOCATION —— 那条权限对银行类 App 的扫描器来说
         是高风险信号，而这里并不需要它。文件写入同理，改用 MediaStore，
         于是 MANAGE_EXTERNAL_STORAGE（全盘访问）也一起去掉了。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- 听写要在锁屏后继续：前台服务 + microphone 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自己的日历：精确闹钟（12+ 可被用户拒绝，代码里退化成不精确）+ 开机后重排 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <queries>
        <package android:name="com.heytap.speechassist" />
        <package android:name="com.miui.voiceassist" />
        <!-- 权限链的 Shizuku 通道：30+ 要这里开口才看得到它装没装（见 ShizukuHandler） -->
        <package android:name="moe.shizuku.privileged.api" />

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name="com.niki914.zafiro.app.App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppDefault"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--XPOSED-->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/module_scope" />
        <!--XPOSED-->

        <!-- 相机输出：给系统相机一个我们自己的 content uri（EXTRA_OUTPUT）。
            不走 MediaStore：刚 insert 的记录是 IS_PENDING=1，pending 项对非所有者是
            owner-only（URI 授权也压不过），相机（另一个 uid）写不进去。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.niki914.zafiro.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            文本选择菜单入口。不写 android:label：弹层会回落到应用名，写了只是重复。
            三个 filter 元素都必需：隐式 intent 需要 category.DEFAULT，text/* 覆盖
            提供富文本选择的宿主。
        -->
        <activity
            android:name="com.niki914.zafiro.app.trigger.TextActionActivity"
            android:label="@string/text_action_menu_label"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppDefault.TextAction">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <!--
                包可见性 workaround，不是链接处理器：某些编辑器自己 query
                PROCESS_TEXT handlers 但没声明匹配的 <queries>，Android 11+ 下
                看不到本包，我们会静默地缺席它们的选择菜单。匹配宿主已声明的
                https 查询即可让本包对它可见（可见性是包级粒度）。
                刻意不带 DEFAULT：不会进入隐式 VIEW 解析，不会成为 https 链接
                处理器。参考 SwiftSlate（MIT）的经验，Gmail 是已验证的宿主例。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".Home"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:targetActivity="com.niki914.zafiro.app.MainActivity">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.niki914.zafiro.runtime.service.AgentRuntimeService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="agent_runtime_ipc" />
            <intent-filter>
                <action android:name="com.niki914.zafiro.runtime.BIND" />
            </intent-filter>
        </service>

        <!-- 跑步记录：只有 declared location 类型的前台服务能在锁屏后继续收定位点 -->
        <service
            android:name="com.niki914.zafiro.app.location.RunTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

            <receiver
            android:name=".schedule.ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.niki914.zafiro.action.SCHEDULE_FIRE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- 应用更新会取消所有闹钟：装一次新版本就把已排的提醒清空了。 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".audio.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 屏幕桥：上游把整块无障碍删掉了，这里是重建的最小实现。
             包名白名单在 filesDir/screen_packages.txt，运行时可改，不必重新授权。 -->
        <receiver
            android:name=".screen.ScreenCmdReceiver"
            android:exported="false" />

        <service
            android:name=".screen.ScreenService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

</application>
</manifest>
